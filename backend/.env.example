PORT=5001
NODE_ENV=development

# Supabase API Credentials (Modern Publishable & Secret Keys)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# PostgreSQL Connection String for DB Setup Script (npm run db:setup)
# NOTE: Use the IPv4 Connection Pooler string from Supabase Settings -> Database if db.[ref].supabase.co fails DNS lookup!
# Format (IPv4 Pooler): postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Format (Direct IPv6): postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.xncqiijhspglsjwzilie:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
